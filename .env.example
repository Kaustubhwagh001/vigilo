# ------------------------------------------------------------
# vigilo — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------

# otel-collector/agent/otel-collector-deploy.sh
OTLP_HTTP_BACKEND_ENDPOINT=https://otel-gateway.example.internal
COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.91.0

# otel-collector/agent/apm-server-deploy.sh
ELASTICSEARCH_URL=https://elastic.example.com:443
ELASTICSEARCH_USERNAME=your-username
ELASTICSEARCH_PASSWORD=your-password
APM_SERVER_IMAGE=docker.elastic.co/apm/apm-server:7.17.1

# docs/nodejs-instrumentation.md (app-side, not collector config)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-my-app.my-namespace.svc.cluster.local:4318
OTEL_SERVICE_NAME=my-service
OTEL_RESOURCE_PLATFORM=my-platform
OTEL_RESOURCE_SUB_PLATFORM=my-sub-platform
OTEL_RESOURCE_COMPONENT_TYPE=api
OTEL_RESOURCE_ENV=dev

# grafana-agent/linux/*.sh (all scripts)
METRICS_REMOTE_WRITE_URL=https://mimir.example.internal/api/v1/push
TENANT_ID=tenant-a

# grafana-agent/linux/grafana-agent-host-install.sh, grafana-agent-crio-exporter.sh,
# grafana-agent-docker-exporter.sh, grafana-agent-etcd-exporter.sh (binary pinning)
GRAFANA_AGENT_VERSION=v0.40.3
ARTIFACT_BASE_URL=https://github.com/grafana/agent/releases/download/v0.40.3

# grafana-agent/linux/grafana-agent-etcd-exporter.sh
ETCD_CLIENT_CERT_FILE=/etc/kubernetes/pki/apiserver-etcd-client.crt
ETCD_CLIENT_KEY_FILE=/etc/kubernetes/pki/apiserver-etcd-client.key

# grafana-agent/linux/grafana-agent-k8s-cluster-metrics.sh
GRAFANA_AGENT_K8S_IMAGE=grafana/agent:v0.40.3
MIMIR_USERNAME=mimir
MIMIR_PASSWORD=your-password
CLUSTER_NAME=my-k8s-cluster

# grafana-agent/linux/*.sh (optional — omit to skip portal registration entirely)
PORTAL_API_BASE_URL=https://observability-portal.example.com
PORTAL_DASHBOARD_TEMPLATE_ID=your-dashboard-template-id
PORTAL_ALERT_TECHNOLOGY_ID=your-alert-technology-id
PORTAL_REGISTER_SCRIPT_URL=https://artifacts.example.com/fleet/server-info.sh

# grafana-agent/integrations/kafka.sh, kafka-connect.sh
# (also reuse METRICS_REMOTE_WRITE_URL, TENANT_ID, GRAFANA_AGENT_VERSION,
# ARTIFACT_BASE_URL, and the optional PORTAL_* vars defined above)
KAFKA_EXPORTER_TARGETS=kafka-broker-1.example.com:7076,kafka-broker-2.example.com:7076
KAFKA_BROKER_URIS=kafka-broker-1.example.com:9092,kafka-broker-2.example.com:9092
ZOOKEEPER_EXPORTER_TARGETS=zookeeper-1.example.com:7075,zookeeper-2.example.com:7075
KAFKA_CLUSTER_NAME=kafka-cluster
KAFKA_CONNECT_TARGETS=kafka-connect-1.example.com:7077
KAFKA_CONNECT_KAFKA_URIS=kafka-broker-1.example.com:9092
KAFKA_CONNECT_CLUSTER_NAME=kafka-connect-cluster

# grafana-agent/integrations/mongodb.sh, mysql.sh, oracle.sh, postgresql.sh,
# redis.sh, scylladb.sh, elasticsearch.sh
# (also reuse METRICS_REMOTE_WRITE_URL, GRAFANA_AGENT_VERSION,
# ARTIFACT_BASE_URL, and the optional PORTAL_* vars defined above)
MONGODB_HOST=10.0.0.11:27017
MONGODB_USER=metrics_reader
MONGODB_PASSWORD=change-me
MONGODB_SERVICE_NAME=mongodb-node1
MONGODB_CLUSTER_NAME=mongodb-cluster

MYSQL_EXPORTER_HOST=10.0.0.12:3306
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=change-me

ORACLE_HOST=10.0.0.13:1521
ORACLE_SERVICE_NAME=XE
ORACLE_USER=metrics_reader
ORACLE_PASSWORD=change-me

POSTGRES_EXPORTER_HOST=10.0.0.14:5432
POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=change-me
POSTGRES_EXPORTER_DBNAME=postgres
POSTGRES_EXPORTER_SSLMODE=disable

REDIS_HOST=10.0.0.15:6379
REDIS_PASSWORD=change-me
REDIS_HOSTNAME_LABEL=redis-host
REDIS_EXPORTER_VERSION=1.32.0
PROMETHEUS_VERSION=2.32.0-beta.0

# scylladb.sh uses the single-value TENANT_ID above, not a positional
# per-tenant list like its siblings
SCYLLA_EXPORTER_TARGET=10.0.0.17:9180

# Distinct from ELASTICSEARCH_URL/USERNAME/PASSWORD above, which configure
# otel-collector/agent's APM-server backend, not the cluster this
# integration monitors
ELASTICSEARCH_EXPORTER_HOST=10.0.0.16:9200
ELASTICSEARCH_EXPORTER_USER=elastic
ELASTICSEARCH_EXPORTER_PASSWORD=change-me
ELASTICSEARCH_EXPORTER_SSL_SKIP_VERIFY=true

# loki/promtail/promtail-systemd-install.sh, promtail-k8s-daemonset.sh
LOKI_PUSH_URL=https://loki.example.internal/loki/api/v1/push
PROMTAIL_VERSION=2.9.9
CONTAINER_ROOT=/var/log/pods
# CLUSTER_NAME is also used here (see grafana-agent-k8s-cluster-metrics.sh
# above) as the DaemonSet's external_labels.cluster_name value

# otel-collector/host/integrations/*.sh (all scripts — where each fragment
# gets written; merged by hand into the host otelcol-contrib config, see
# that folder's README)
# (also reuse TENANT_ID above as the resource/<name> processor's tenant.id)
OTELCOL_CONF_DIR=/etc/otelcol-contrib/conf.d
DEPLOYMENT_ENVIRONMENT=prod

# otel-collector/host/integrations/cassandra.sh
CASSANDRA_EXPORTER_HOST=10.0.0.20:9500
CASSANDRA_EXPORTER_CRITEO_PORT=8080

# otel-collector/host/integrations/mongodb.sh
# (also reuses MONGODB_HOST/MONGODB_USER/MONGODB_PASSWORD above — same
# credentials/host as grafana-agent/integrations/mongodb.sh's
# mongodb_exporter integration, just a native receiver instead of an
# exporter; run once per replica-set member)
MONGODB_REPLICA_SET=my-replica-set

# otel-collector/host/integrations/mysql.sh
# Distinct from MYSQL_EXPORTER_HOST/USER/PASSWORD above
# (grafana-agent/integrations/mysql.sh) — this is a direct connection via
# the native mysqlreceiver, there is no mysqld_exporter process involved
MYSQL_HOST=10.0.0.12:3306
MYSQL_USER=otel_metrics_reader
MYSQL_PASSWORD=change-me

# otel-collector/host/integrations/redis.sh
# (also reuses REDIS_HOST/REDIS_PASSWORD above — same credentials/host as
# grafana-agent/integrations/redis.sh's redis_exporter, just a native
# receiver instead of an exporter+Prometheus pair)
REDIS_OTEL_COLLECTION_INTERVAL=60s
REDIS_LOG_PATH=/var/log/redis/*.log
REDIS_NORMALIZE_UPTIME_GAUGE=false

# otel-collector/host/integrations/scylladb.sh
# (also reuses SCYLLA_EXPORTER_TARGET above)
SCYLLA_OTEL_SCRAPE_INTERVAL=60s

# otel-collector/host/integrations/rabbitmq.sh
RABBITMQ_EXPORTER_TARGET=10.0.0.18:15692
RABBITMQ_OTEL_SCRAPE_INTERVAL=60s

# otel-collector/host/integrations/elasticsearch.sh
# (also reuses ELASTICSEARCH_EXPORTER_HOST/USER/PASSWORD/SSL_SKIP_VERIFY
# above — same cluster credentials as
# grafana-agent/integrations/elasticsearch.sh's elasticsearch_exporter,
# just a native receiver talking to the REST API directly instead of an
# exporter sidecar)
ELASTICSEARCH_OTEL_ENDPOINT_SCHEME=https
ELASTICSEARCH_OTEL_COLLECTION_INTERVAL=1m
ELASTICSEARCH_LOG_PATH=/var/log/elasticsearch/*.log

# otel-collector/host/integrations/kafka-ssl.sh
# (also reuses KAFKA_EXPORTER_TARGETS/ZOOKEEPER_EXPORTER_TARGETS above —
# same targets as grafana-agent/integrations/kafka.sh, just scraped by an
# OTel prometheus receiver instead of Grafana Agent. Despite the script's
# name, the source config had no TLS/SASL settings — see its header.)
KAFKA_LAG_EXPORTER_TARGETS=kafka-lag-exporter.example.com:9308
KAFKA_OTEL_LOG_PATH=/kafka/log/*

# otel-collector/host/linux/otelcol-host-install.sh,
# otel-collector/host/windows/otelcol-host-install.ps1
# (also reuses TENANT_ID and DEPLOYMENT_ENVIRONMENT above — same meaning:
# which tenant/environment this host's telemetry belongs to)
OTLP_BACKEND_ENDPOINT=otel-gateway.example.internal:4317
COLLECTOR_VERSION=0.138.0
SERVICE_NAME=host
RESOURCE_DETECTORS=env,system
PROCESS_NAME_FILTER=otelcol.*,systemd.*,node.*
SYSLOG_PATH=/var/log/syslog
ENABLE_JOURNALD=false
JOURNALD_UNITS=ssh
EXTRA_PROMETHEUS_TARGETS=
# Optional — only needed if RESOURCE_DETECTORS includes "gcp" and the host
# isn't on GCE (where the metadata server covers this for free)
GOOGLE_APPLICATION_CREDENTIALS=/etc/otelcol-contrib/sakey.json

# otel-collector/host/windows/otelcol-host-install.ps1 (Windows-only)
EVENTLOG_CHANNELS=Application,System
INSTALL_DIR=C:\observability-agent

# grafana-agent/integrations/clickhouse.sh
# (also reuses METRICS_REMOTE_WRITE_URL, TENANT_ID, GRAFANA_AGENT_VERSION,
# ARTIFACT_BASE_URL defined above; ClickHouse itself must have its
# Prometheus endpoint enabled separately — see the script's header comment)
CLICKHOUSE_EXPORTER_TARGET=clickhouse.example.internal:9363

# alloy/windows/*.alloy (read via River's sys.env() at runtime, not by a
# shell script — set these as machine-level environment variables before
# starting the Alloy service; also reuses METRICS_REMOTE_WRITE_URL,
# TENANT_ID, LOKI_PUSH_URL defined above)

# alloy/windows/alloy-windows-install.ps1
# (ARTIFACT_BASE_URL is also reused here, as an optional override — this
# script computes its own default from ALLOY_VERSION if unset, pointing at
# the public grafana/alloy GitHub releases rather than grafana/agent)
ALLOY_VERSION=v1.22.0
ALLOY_CONFIG_FILE=windows-host-monitoring.alloy
